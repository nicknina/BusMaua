# Endereço do backend. Vazio = usa o proxy do Vite (recomendado em desenvolvimento).
VITE_API_URL=

# Endereço do WebSocket. Vazio = mesmo host do app, caminho /ws.
VITE_WS_URL=

# true = o celular do motorista simula o trajeto pelas paradas (útil para apresentar sem sair do lugar)
VITE_SIMULAR_GPS=false
